# Lokalna privzeta konfiguracija NetSentinel IDS. Kopiraj v .env.local in prilagodi računalniku.

# REST API
REST_API_HOST=0.0.0.0
REST_API_PORT=8080
REST_API_LOG_LEVEL=INFO

# Demonstracijski način. Omogoči ga za stabilen prikaz brez zajema živih paketov.
NETSENTINEL_SIMULATE_ATTACKS=1
NETSENTINEL_SIMULATE_INTERVAL_MS=1500
# Največ en nizko-tveganjski alarm za dejanski promet v tem intervalu.
NETSENTINEL_BENIGN_ALERT_INTERVAL_SEC=10

# Zajem v živo. V Windows uporabi identifikator naprave Npcap, v Linuxu ime vmesnika.
# Samodejno, eth0/eth1 ali wlan0; velja po ponovnem zagonu zaledja.
NETSENTINEL_INTERFACE=Auto-detect
NETSENTINEL_DEVICE_GUID=

# Nastavitve stabilnosti grafičnega vmesnika
NETSENTINEL_PRESENTATION_MODE=0
NETSENTINEL_SAFE_MODE=0
NETSENTINEL_DEBUG_GUI=0
NETSENTINEL_VERBOSE=0

# Izbirna infrastruktura
# Ko je PostgreSQL dosegljiv, nastavi POSTGRES_ENABLED=1 za arhiviranje incidentov.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=netsentinel_user
POSTGRES_PASSWORD=nastavi_lokalno
POSTGRES_DB=netsentinel_db
POSTGRES_ENABLED=0
POSTGRES_CONNECTION_STRING=postgresql://netsentinel_user:admin@localhost:5432/netsentinel_db

INFLUXDB_URL=http://localhost:8086
INFLUX_URL=http://localhost:8086
INFLUXDB_ORG=NetSentinel
INFLUXDB_BUCKET=flows
INFLUXDB_TOKEN=nastavi_lokalno

# Privzete nastavitve zaznavanja
NETSENTINEL_THRESHOLD=0.5
NETSENTINEL_NAME=NetSentinel-01
NETSENTINEL_ML_ENABLED=1
NETSENTINEL_STATISTICAL_ENABLED=1
IDS_DEVICE=cpu
